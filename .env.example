# Copie este arquivo para ".env", informe sua chave Groq e nunca publique o ".env" real.
# Obtenha uma chave em https://console.groq.com/keys

# --- API compatível com OpenAI (Groq) ---
LLM_API_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=

# --- Opcionais ---
LLM_MAX_TOKENS=1000
LLM_TIMEOUT=120
