# Copie este arquivo para ".env". Não publique o ".env" real.

# --- API compatível com OpenAI (serviço LLM interno, porta 9001) ---
LLM_BASE_URL=https://llm-internal.softex:9001/v1
LLM_API_KEY=qualquer
LLM_MODEL=qwen3.5:9b-q4_K_M

# --- Aplicação web P0 (porta HTTP separada da LLM) ---
PORT=8000

# --- Opcionais ---
LLM_MAX_TOKENS=100000
LLM_TIMEOUT=120
