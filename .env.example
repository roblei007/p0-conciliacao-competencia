# Copie este arquivo para ".env" e preencha. NUNCA publique o ".env" real.
# Linux/macOS/WSL: cp .env.example .env      Windows (PowerShell): Copy-Item .env.example .env

# --- Ollama interno (a chave não é necessária por padrão) ---
LLM_API_URL=https://llm-internal.softex:9001/api/chat
LLM_MODEL=qwen3.5:9b-q4_K_M

# Se o servidor exigir autenticação, informe a chave abaixo:
# LLM_API_KEY=

# --- Opcionais ---
LLM_MAX_TOKENS=1000
LLM_TIMEOUT=120
# LOG_LEVEL=INFO               # DEBUG, INFO, WARNING ou ERROR
# LOG_ARQUIVO=logs/execucao.log
