# Copie este arquivo para ".env" e preencha. NUNCA publique o ".env" real.
# Linux/macOS/WSL: cp .env.example .env      Windows (PowerShell): Copy-Item .env.example .env

# --- Obrigatórias ---
LLM_API_KEY=sua_chave_de_api_aqui
# Nome do modelo conforme o provedor indicado pela coordenação (ou a documentação do provedor)
LLM_MODEL=claude-haiku-5-5

# --- Provedor (padrão: API de Mensagens da Anthropic) ---
# Se o LLM institucional usar o formato "chat/completions" (compatível com OpenAI), descomente:
# LLM_API_FORMAT=openai
# LLM_API_URL=https://endereco-do-seu-provedor/v1/chat/completions   (obrigatória no formato openai)
# LLM_API_FORMAT=anthropic
# LLM_API_URL=https://api.anthropic.com/v1/messages

# --- Opcionais (valores abaixo são os padrões) ---
# LLM_API_VERSION=2023-06-01   # só no formato anthropic
# LLM_MAX_TOKENS=1500          # limite de tokens da resposta (1 a 8192)
# LLM_TEMPERATURE=0.0          # 0.0 a 1.0; deixe em branco para não enviar o parâmetro
# LLM_TIMEOUT=30               # segundos de espera pela resposta
# LOG_LEVEL=INFO               # DEBUG, INFO, WARNING ou ERROR
# LOG_ARQUIVO=logs/execucao.log
